{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.tests.json",
    "test": "tsx --test tests/listagem.test.ts tests/recursos.test.ts tests/acesso.test.ts tests/beneficioRegras.test.ts tests/utilizacaoVinculos.test.ts",
    "test:mysql": "tsx --test tests/mysql.test.ts",
    "dev": "tsx watch src/server.ts",
    "knex": "tsx node_modules/knex/bin/cli.js",
    "db:migrate": "npm run knex -- migrate:latest",
    "db:seed": "npm run knex -- seed:run",
    "db:reset": "npm run knex -- migrate:rollback --all && npm run db:migrate && npm run db:seed"
  },
  "keywords": [],
